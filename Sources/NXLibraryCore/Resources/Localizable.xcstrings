    "Scales internal 3D scene resolution from 50% to 100% (DM_RENDER_SCALE). Decreasing internal resolution boosts framerates on demanding titles while UI overlays remain crisp.": {
      "comment": "GameOptionsPresentation.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scales internal 3D scene resolution from 50% to 100% (DM_RENDER_SCALE). Decreasing internal resolution boosts framerates on demanding titles while UI overlays remain crisp."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridimensiona la risoluzione interna della scena 3D dal 50% al 100% (DM_RENDER_SCALE). Ridurre la risoluzione interna aumenta la frequenza dei fotogrammi nei titoli più esigenti, mentre l’interfaccia in sovrimpressione resta nitida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la résolution 3D interne de 50 % à 100 % (DM_RENDER_SCALE). Réduire la résolution interne augmente la fréquence d’images des titres exigeants, tandis que les éléments d’interface restent nets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert die interne 3D-Szenenauflösung von 50% bis 100% (DM_RENDER_SCALE). Eine geringere interne Auflösung erhöht bei anspruchsvollen Titeln die Bildrate, während UI-Einblendungen scharf bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala la resolución interna de la escena 3D del 50% al 100% (DM_RENDER_SCALE). Reducirla aumenta los fotogramas por segundo en títulos exigentes y mantiene nítida la interfaz superpuesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta a resolução interna da cena 3D de 50% a 100% (DM_RENDER_SCALE). Reduzir a resolução interna aumenta a taxa de quadros em jogos exigentes, enquanto a interface sobreposta permanece nítida."
          }
        }
      }
    },
    "Scales the internal 3D rendering buffer relative to native target (50% to 100%). Lowering this reduces GPU heat on battery; UI remains full resolution.": {
      "comment": "SettingsGamesSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scales the internal 3D rendering buffer relative to native target (50% to 100%). Lowering this reduces GPU heat on battery; UI remains full resolution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridimensiona il buffer di rendering 3D interno rispetto alla risoluzione nativa prevista (dal 50% al 100%). Ridurlo limita il calore della GPU quando usi la batteria; l’interfaccia resta a piena risoluzione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la résolution du tampon de rendu 3D interne par rapport à la cible native (50 % à 100 %). La réduire limite l’échauffement du GPU sur batterie ; l’interface reste en pleine résolution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert den internen 3D-Renderpuffer relativ zur nativen Zielauflösung (50% bis 100%). Ein niedrigerer Wert reduziert im Akkubetrieb die GPU-Wärmeentwicklung; die Benutzeroberfläche bleibt in voller Auflösung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala el búfer de renderizado 3D interno respecto al objetivo nativo (del 50% al 100%). Reducirlo disminuye el calor de la GPU al usar batería; la interfaz mantiene la resolución completa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta a escala do buffer de renderização 3D interno em relação à resolução nativa (50% a 100%). Reduzir esse valor diminui o aquecimento da GPU ao usar a bateria; a interface mantém a resolução total."
          }
        }
      }
    },
