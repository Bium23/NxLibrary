    "Storage warning: this build needs ~%@ free (twice the selected sources plus 10 GB), but only %@ is available. Free at least %@ before adding it.": {
      "comment": "App-owned presentation copy; preserve data identifiers separately.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage warning: this build needs ~%@ free (twice the selected sources plus 10 GB), but only %@ is available. Free at least %@ before adding it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione allo spazio: questa build richiede circa %@ liberi (il doppio delle sorgenti selezionate più 10 GB), ma sono disponibili solo %@. Libera almeno %@ prima di aggiungerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention au stockage : cette compilation nécessite environ %@ libres (deux fois les sources sélectionnées plus 10 Go), mais seuls %@ sont disponibles. Libérez au moins %@ avant de l’ajouter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherwarnung: Dieser Build benötigt etwa %@ freien Speicher (das Doppelte der ausgewählten Quelldateien plus 10 GB), aber nur %@ sind verfügbar. Gib mindestens %@ frei, bevor du ihn hinzufügst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
