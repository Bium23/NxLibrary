          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NX Library ist persönliche Software unter der MIT-Lizenz. nxnative, Ryujinx, SPIR-V Cross, LibHac und die übrigen Abhängigkeiten behalten über die Engine ihre eigenen Lizenzen."
          }
        },
