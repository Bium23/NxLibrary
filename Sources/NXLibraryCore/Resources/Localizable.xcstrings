    "Cheats change values while you play, for this version only. New items, looks or gameplay are in Mods.": {
      "comment": "CheatCopy.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheats change values while you play, for this version only. New items, looks or gameplay are in Mods."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I trucchi modificano i valori mentre giochi, solo per questa versione. Nuovi oggetti, aspetti o modalità di gioco si trovano in Mod."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes de triche modifient des valeurs pendant le jeu, pour cette version uniquement. Les nouveaux objets, apparences ou mécanismes de jeu se trouvent dans Mods."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheats ändern Werte während des Spielens und gelten nur für diese Version. Neue Gegenstände, Designs oder Spielmechaniken findest du unter „Mods“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
