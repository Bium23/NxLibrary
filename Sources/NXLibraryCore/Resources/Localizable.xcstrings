    "Off keeps every cheat from running, whatever is switched on.": {
      "comment": "CheatsPanel.swift:284",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off keeps every cheat from running, whatever is switched on."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, impedisce l’esecuzione di tutti i trucchi, anche di quelli attivi."
