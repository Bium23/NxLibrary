    "Keep the game closed, including launches from Finder, until the operation finishes.": {
      "comment": "Save safety and presentation; user content stays unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the game closed, including launches from Finder, until the operation finishes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni il gioco chiuso, anche evitando avvii dal Finder, finché l’operazione non termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le jeu fermé, y compris depuis le Finder, jusqu’à la fin de l’opération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Spiel geschlossen und starte es auch nicht im Finder, bis der Vorgang abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el juego cerrado, también al abrirlo desde Finder, hasta que termine la operación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o jogo fechado, sem iniciá-lo pelo Finder, até a operação terminar."
          }
        }
      }
    },
