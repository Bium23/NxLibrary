    " A large game takes about a minute.": {
      "comment": "ChangeArtworkView.swift:193",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " A large game takes about a minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Per un gioco di grandi dimensioni serve circa un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Cela prend environ une minute pour un jeu volumineux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Bei großen Spielen dauert das etwa eine Minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Un juego grande tarda aproximadamente un minuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Um jogo grande leva cerca de um minuto."
          }
        }
      }
    },
    " Builds are recorded as untested.": {
      "comment": "ToolchainGateCopy.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Builds are recorded as untested."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Le compilazioni sono registrate come non testate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les compilations sont enregistrées comme non testées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Builds werden als ungetestet erfasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Las compilaciones se registran como no probadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " As compilações são registradas como não testadas."
          }
        }
      }
    },
    " It changes when the game quits.": {
      "comment": "ChangeArtworkView.swift:193",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " It changes when the game quits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Cambia alla chiusura del gioco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Elle sera modifiée à la fermeture du jeu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Wird geändert, sobald das Spiel beendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Se cambia cuando se cierra el juego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " A alteração será aplicada quando o jogo for encerrado."
          }
        }
      }
    },
    " Rebuild to use cheats.": {
      "comment": "CheatsPanel.swift:109",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Rebuild to use cheats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Ricompila per usare i trucchi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Recompilez pour utiliser les codes de triche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Erstelle die App erneut, um Cheats zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Recompila para usar trucos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Recompile para usar trapaças."
          }
        }
      }
    },
    " The Game apps folder's drive can't hold build files (it needs APFS or Mac OS Extended), so the build uses this Mac's disk.": {
      "comment": "App-owned presentation copy; preserve data identifiers separately.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " The Game apps folder's drive can't hold build files (it needs APFS or Mac OS Extended), so the build uses this Mac's disk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " L’unità della cartella App dei giochi non può contenere i file di build (richiede APFS o Mac OS esteso), quindi la build usa il disco di questo Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Le disque du dossier des apps de jeux ne peut pas héberger les fichiers de compilation (APFS ou Mac OS étendu requis). La compilation utilise donc le disque de ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Das Laufwerk des Spiele-App-Ordners kann keine Build-Dateien speichern (APFS oder Mac OS Extended erforderlich). Daher nutzt der Build die Festplatte dieses Macs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " La unidad de la carpeta de apps de juegos no puede guardar archivos de compilación (requiere APFS o Mac OS Plus), por lo que se usa el disco de este Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " A unidade da pasta de apps de jogos não pode armazenar arquivos de compilação (requer APFS ou Mac OS Expandido), então a compilação usa o disco deste Mac."
          }
        }
      }
    },
    " The log has the details.": {
      "comment": "BuildWarningCopy.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " The log has the details."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Il log contiene i dettagli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Le journal contient les détails."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Einzelheiten stehen im Protokoll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " El registro contiene los detalles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " O log contém os detalhes."
          }
        }
      }
    },
    " There should be no problems: turn on Untested toolchain override to build.": {
      "comment": "ToolchainGateCopy.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " There should be no problems: turn on Untested toolchain override to build."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Non dovrebbero esserci problemi: attiva Ignora controllo della toolchain non testata per compilare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Aucun problème n’est attendu : activez Dérogation pour chaîne d’outils non testée pour compiler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Es sollten keine Probleme auftreten: Aktiviere „Ungetestete Toolchain zulassen“, um Apps zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " No debería haber problemas: activa Permitir cadena de herramientas no probada para compilar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Não deve haver problemas: ative Permitir conjunto de ferramentas não testado para compilar."
          }
        }
      }
    },
    " There should be no problems; builds are recorded as untested.": {
      "comment": "ToolchainGateCopy.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " There should be no problems; builds are recorded as untested."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Non dovrebbero esserci problemi; le compilazioni sono registrate come non testate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Aucun problème n’est attendu ; les compilations sont enregistrées comme non testées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Es sollten keine Probleme auftreten; Builds werden als ungetestet erfasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " No debería haber problemas; las compilaciones se registran como no probadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Não deve haver problemas; as compilações são registradas como não testadas."
          }
        }
      }
    },
    " This cache is also used by %@; their next rebuilds may take longer too.": {
      "comment": "SettingsStorageSection.swift:168",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " This cache is also used by %@; their next rebuilds may take longer too."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Questa cache viene usata anche da %@; anche le relative ricompilazioni potrebbero richiedere più tempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Ce cache est aussi utilisé par %@ ; leurs prochaines recompilations peuvent également prendre plus de temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Dieser Cache wird auch von %@ verwendet; die nächsten Neuerstellungen dieser Spiele können ebenfalls länger dauern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Esta caché también se usa para %@; sus próximas recompilaciones también podrían tardar más."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Este cache também é usado por %@; as próximas recompilações desses jogos também podem demorar mais."
          }
        }
      }
    },
    " Untested toolchain override builds anyway, at your own risk.": {
      "comment": "ToolchainGateCopy.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Untested toolchain override builds anyway, at your own risk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Ignora controllo della toolchain non testata consente di compilare comunque, a tuo rischio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " La dérogation pour chaîne d’outils non testée permet tout de même de compiler, à vos risques et périls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " „Ungetestete Toolchain zulassen“ ermöglicht Builds trotzdem, auf eigenes Risiko."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Permitir cadena de herramientas no probada deja compilar de todos modos, bajo tu responsabilidad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Permitir conjunto de ferramentas não testado compila mesmo assim, por sua conta e risco."
          }
        }
      }
    },
    " Your theme’s own background takes its place.": {
      "comment": "ThemePickerView.swift:834",
      "localizations": {
        "en": {
