    "Files in iCloud Drive or another synced folder carry data that code signing refuses.": {
      "comment": "PortingFailureReason.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files in iCloud Drive or another synced folder carry data that code signing refuses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file in iCloud Drive o in un’altra cartella sincronizzata contengono dati che la firma del codice rifiuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers dans iCloud Drive ou un autre dossier synchronisé portent des données que la signature de code refuse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien in iCloud Drive oder anderen synchronisierten Ordnern enthalten Daten, die die Codesignierung ablehnt."
          }
        },
        "es": {
          "stringUnit": {
