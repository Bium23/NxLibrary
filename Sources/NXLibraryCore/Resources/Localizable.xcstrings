    "Descriptions, genres and artwork are fetched from the public Nintendo Store catalog for personal use, cached locally for seven days, and never committed or redistributed.": {
      "comment": "SettingsAboutSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descriptions, genres and artwork are fetched from the public Nintendo Store catalog for personal use, cached locally for seven days, and never committed or redistributed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrizioni, generi e immagini vengono recuperati dal catalogo pubblico del Nintendo Store per uso personale, conservati nella cache locale per sette giorni e mai inseriti nel repository o ridistribuiti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les descriptions, genres et illustrations sont récupérés depuis le catalogue public du Nintendo Store pour un usage personnel, mis en cache localement pendant sept jours, et jamais intégrés au dépôt ni redistribués."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibungen, Genres und Artwork werden für den persönlichen Gebrauch aus dem öffentlichen Nintendo Store-Katalog geladen, sieben Tage lokal zwischengespeichert und weder ins Repository aufgenommen noch weiterverbreitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descripciones, los géneros y las imágenes se obtienen del catálogo público de Nintendo Store para uso personal, se guardan en la caché local durante siete días y nunca se incorporan al repositorio ni se redistribuyen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrições, gêneros e artes são obtidos do catálogo público da Nintendo Store para uso pessoal, armazenados em cache local por sete dias e nunca incluídos no repositório ou redistribuídos."
          }
        }
      }
    },
