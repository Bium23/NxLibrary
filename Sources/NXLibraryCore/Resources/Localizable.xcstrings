    "Apple's developer tools. Every game is compiled with them.": {
      "comment": "SetupCheck.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's developer tools. Every game is compiled with them."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli strumenti di sviluppo di Apple. Ogni gioco viene compilato con questi strumenti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils de développement d’Apple. Chaque jeu est compilé avec eux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples Entwicklerwerkzeuge. Jedes Spiel wird damit kompiliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas de desarrollo de Apple. Todos los juegos se compilan con ellas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas de desenvolvimento da Apple. Todos os jogos são compilados com elas."
          }
        }
      }
    },
    "Applied before each game starts, including Off. Reset group keeps cloud sync and its folder. Custom save-sync overrides are reported in Saves.": {
      "comment": "SettingsGamesSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied before each game starts, including Off. Reset group keeps cloud sync and its folder. Custom save-sync overrides are reported in Saves."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicato prima di ogni avvio, anche se disattivato. Reimposta gruppo conserva la sincronizzazione cloud e la relativa cartella. Le impostazioni personalizzate che prevalgono sulla sincronizzazione dei salvataggi sono indicate in Salvataggi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué avant chaque démarrage de jeu, y compris Désactivé. Réinitialiser le groupe conserve la synchronisation cloud et son dossier. Les réglages personnalisés de synchronisation des sauvegardes sont signalés dans Sauvegardes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird vor jedem Spielstart angewendet, auch „Aus“. „Gruppe zurücksetzen“ behält die Cloud-Synchronisierung und ihren Ordner bei. Eigene Überschreibungen der Spielstandsynchronisierung werden unter „Spielstände“ angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica antes de iniciar cada juego, también al desactivarlo. Restablecer el grupo conserva la sincronización en la nube y su carpeta. Las personalizaciones de sincronización de partidas se indican en Partidas guardadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado antes de cada jogo iniciar, inclusive Desativado. Redefinir o grupo mantém a sincronização na nuvem e sua pasta. Substituições personalizadas da sincronização são informadas em Dados salvos."
          }
        }
      }
    },
    "Applies at the next launch.": {
      "comment": "SettingsStartUpSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies at the next launch."
