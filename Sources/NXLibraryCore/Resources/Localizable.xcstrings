    "On shows the selected game's art in Spotlight and Collection; Off keeps your wallpaper. Details keeps the game's art.": {
      "comment": "SettingsCatalog.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On shows the selected game's art in Spotlight and Collection; Off keeps your wallpaper. Details keeps the game's art."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, mostra le immagini del gioco selezionato in Spotlight e Raccolta; se disattivo, mantiene il tuo sfondo. Dettagli mantiene le immagini del gioco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé affiche l’illustration du jeu sélectionné dans À la une et Collection ; Désactivé conserve votre fond d’écran. Détails conserve l’illustration du jeu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ein“ zeigt das Artwork des ausgewählten Spiels in Spotlight und Sammlung; „Aus“ behält dein Hintergrundbild. Details behält das Artwork des Spiels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado muestra las imágenes del juego seleccionado en Destacados y Colección; Desactivado conserva tu fondo. Detalles conserva las imágenes del juego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado mostra a arte do jogo selecionado em Destaques e Coleção; Desativado mantém seu papel de parede. Detalhes mantém a arte do jogo."
          }
        }
      }
    },
    "On shows the selected game's artwork; Off keeps your wallpaper. Details and the launch screen keep their own artwork settings.": {
      "comment": "SettingsLookSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On shows the selected game's artwork; Off keeps your wallpaper. Details and the launch screen keep their own artwork settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, mostra le immagini del gioco selezionato; se disattivo, mantiene il tuo sfondo. Dettagli e schermata di avvio conservano le proprie impostazioni per le immagini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé affiche l’illustration du jeu sélectionné ; Désactivé conserve votre fond d’écran. Détails et l’écran de lancement gardent leurs propres réglages d’illustration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ein“ zeigt das Artwork des ausgewählten Spiels; „Aus“ behält dein Hintergrundbild. Details und Startbildschirm behalten ihre eigenen Artwork-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlo, muestra las imágenes del juego seleccionado; al desactivarlo, conserva tu fondo de pantalla. Detalles y la pantalla de inicio mantienen sus propios ajustes de imágenes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado mostra a arte do jogo selecionado; Desativado mantém seu papel de parede. Detalhes e a tela de abertura mantêm seus próprios ajustes de arte."
          }
        }
      }
    },
    "On targets 60 FPS; Off targets 30 FPS. Some games run too fast at 60 FPS.": {
      "comment": "GameOptionsPresentation.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On targets 60 FPS; Off targets 30 FPS. Some games run too fast at 60 FPS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, punta a 60 FPS; se disattivo, a 30 FPS. Alcuni giochi girano troppo velocemente a 60 FPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé vise 60 FPS ; Désactivé vise 30 FPS. Certains jeux tournent trop vite à 60 FPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ein“ strebt 60 FPS an; „Aus“ strebt 30 FPS an. Manche Spiele laufen mit 60 FPS zu schnell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado fija un objetivo de 60 FPS; Desactivado, de 30 FPS. Algunos juegos van demasiado rápido a 60 FPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado visa 60 FPS; Desativado visa 30 FPS. Alguns jogos ficam rápidos demais a 60 FPS."
          }
        }
      }
    },
