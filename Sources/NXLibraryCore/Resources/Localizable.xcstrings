      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download was damaged. Try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file scaricato è danneggiato. Riprova."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement est endommagé. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download war beschädigt. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga está dañada. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download está corrompido. Tente novamente."
          }
        }
      }
    },
    "The engine and compiler do not match the certified combination. Builds may fail or show incorrect graphics and will be marked as untested.": {
      "comment": "SettingsEngineSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine and compiler do not match the certified combination. Builds may fail or show incorrect graphics and will be marked as untested."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore e il compilatore non corrispondono alla combinazione certificata. Le compilazioni potrebbero non riuscire o mostrare errori grafici e saranno contrassegnate come non testate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur et le compilateur ne correspondent pas à la combinaison certifiée. Les compilations peuvent échouer ou présenter des erreurs graphiques et seront marquées comme non testées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine und Compiler entsprechen nicht der zertifizierten Kombination. Builds können fehlschlagen oder fehlerhafte Grafik anzeigen und werden als ungetestet markiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor y el compilador no coinciden con la combinación certificada. Las compilaciones podrían fallar o mostrar gráficos incorrectos y se marcarán como no probadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A engine e o compilador não correspondem à combinação certificada. As compilações podem falhar ou exibir gráficos incorretos e serão marcadas como não testadas."
          }
        }
      }
    },
    "The engine commit is not a valid hash.": {
      "comment": "UpstreamChecker.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine commit is not a valid hash."
