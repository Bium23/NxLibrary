    "Existing game apps play without sources. Choose later in Settings → Library.": {
      "comment": "SetupCheck.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing game apps play without sources. Choose later in Settings → Library."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app dei giochi esistenti funzionano senza sorgenti. Puoi scegliere più tardi in Impostazioni → Libreria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps de jeux existantes fonctionnent sans sources. Vous pourrez choisir plus tard dans Réglages → Bibliothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Spiele-Apps lassen sich ohne Quellen spielen. Wähle sie später unter Einstellungen → Bibliothek aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps de juegos existentes se pueden ejecutar sin sus archivos de origen. Puedes elegirlos más tarde en Ajustes → Biblioteca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps de jogos existentes funcionam sem os arquivos de origem. Escolha depois em Ajustes → Biblioteca."
          }
        }
      }
    },
    "Existing game apps play without their sources. Reset group keeps this folder. Clear removes the selection, keeping your files.": {
      "comment": "SettingsLibrarySection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing game apps play without their sources. Reset group keeps this folder. Clear removes the selection, keeping your files."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app dei giochi esistenti funzionano anche senza sorgenti. Reimposta gruppo conserva questa cartella. Svuota rimuove la selezione, conservando i tuoi file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps de jeux existantes fonctionnent sans leurs sources. Réinitialiser le groupe conserve ce dossier. Effacer retire la sélection et conserve vos fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Spiele-Apps lassen sich ohne ihre Quellen spielen. „Gruppe zurücksetzen“ behält diesen Ordner bei. „Leeren“ entfernt die Auswahl und behält deine Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps de juegos existentes se pueden ejecutar sin sus archivos de origen. Restablecer el grupo conserva esta carpeta. Borrar quita la selección y conserva tus archivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps de jogos existentes funcionam sem os arquivos de origem. Redefinir o grupo mantém esta pasta. Limpar remove a seleção e mantém seus arquivos."
          }
        }
      }
    },
