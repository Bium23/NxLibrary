    "Displays Apple's official Metal Performance HUD overlay during gameplay showing real-time frame rates, frame time graphs, and GPU utilization.": {
      "comment": "SettingsGamesSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays Apple's official Metal Performance HUD overlay during gameplay showing real-time frame rates, frame time graphs, and GPU utilization."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra durante il gioco l’HUD ufficiale Metal Performance HUD di Apple, con frequenza dei fotogrammi in tempo reale, grafici dei tempi dei fotogrammi e utilizzo della GPU."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche en jeu la surimpression officielle Metal Performance HUD d’Apple : fréquence d’images en temps réel, graphiques du temps par image et utilisation du GPU."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt während des Spielens Apples offizielles Metal Performance HUD mit aktueller Bildrate, Framezeitdiagrammen und GPU-Auslastung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra durante el juego el HUD oficial de rendimiento de Metal de Apple con los fotogramas por segundo en tiempo real, gráficos de tiempo por fotograma y uso de GPU."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe a sobreposição oficial Metal Performance HUD da Apple durante o jogo, mostrando a taxa de quadros, gráficos de tempo por quadro e o uso da GPU em tempo real."
          }
        }
      }
    },
    "Displays Apple's real-time Metal developer HUD (DM_METAL_HUD=1). Shows frame rate, frame pacing graphs, GPU time per frame in milliseconds, and memory allocation.": {
      "comment": "GameOptionsPresentation.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays Apple's real-time Metal developer HUD (DM_METAL_HUD=1). Shows frame rate, frame pacing graphs, GPU time per frame in milliseconds, and memory allocation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l’HUD Metal per sviluppatori di Apple in tempo reale (DM_METAL_HUD=1). Mostra frequenza dei fotogrammi, grafici della regolarità dei fotogrammi, tempo GPU per fotogramma in millisecondi e memoria allocata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le HUD Metal de développement d’Apple en temps réel (DM_METAL_HUD=1). Indique la fréquence d’images, les graphiques de régularité des images, le temps GPU par image en millisecondes et l’allocation mémoire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Apples Metal-Entwickler-HUD in Echtzeit (DM_METAL_HUD=1). Zeigt Bildrate, Diagramme zum Frame-Pacing, GPU-Zeit pro Frame in Millisekunden und Speicherbelegung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el HUD de desarrollo de Metal de Apple en tiempo real (DM_METAL_HUD=1). Indica los fotogramas por segundo, gráficos de regularidad de fotogramas, tiempo de GPU por fotograma en milisegundos y memoria asignada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe o HUD de desenvolvimento Metal da Apple em tempo real (DM_METAL_HUD=1). Mostra a taxa de quadros, gráficos de cadência dos quadros, tempo de GPU por quadro em milissegundos e alocação de memória."
          }
        }
      }
    },
