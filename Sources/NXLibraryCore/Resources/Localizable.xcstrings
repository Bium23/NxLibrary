    "Lets the game lower its resolution under load. Turn off to keep full resolution for the selected console mode.": {
      "comment": "Engine game setting presentation; never translate env keys or values.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the game lower its resolution under load. Turn off to keep full resolution for the selected console mode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente al gioco di ridurre la risoluzione sotto carico. Disattivala per mantenere la piena risoluzione della modalità console selezionata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet au jeu de réduire sa résolution en cas de forte charge. Désactivez pour conserver la pleine résolution du mode de console sélectionné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt dem Spiel, bei hoher Last seine Auflösung zu senken. Deaktivieren, um die volle Auflösung des ausgewählten Konsolenmodus beizubehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el juego reduzca su resolución bajo carga. Desactívalo para mantener la resolución completa del modo de consola seleccionado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o jogo reduza a resolução sob carga. Desative para manter a resolução total do modo de console selecionado."
          }
        }
      }
    },
