    "Fill crops the game's 16:9 picture to cover the screen. Health bars, subtitles or maps near the edges can be cut off. A full-screen picture without cropping needs a patch for each game.": {
      "comment": "Engine game setting presentation; never translate env keys or values.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill crops the game's 16:9 picture to cover the screen. Health bars, subtitles or maps near the edges can be cut off. A full-screen picture without cropping needs a patch for each game."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempi ritaglia l’immagine 16:9 del gioco per coprire lo schermo. Barre della salute, sottotitoli o mappe vicino ai bordi possono essere tagliati. Un’immagine a schermo intero senza ritagli richiede una patch specifica per ogni gioco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplir recadre l’image 16:9 du jeu pour couvrir l’écran. Les barres de vie, sous-titres ou cartes proches des bords peuvent être coupés. Une image en plein écran sans recadrage nécessite un correctif propre à chaque jeu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Füllen“ beschneidet das 16:9-Spielbild bildschirmfüllend. Lebensanzeigen, Untertitel oder Karten am Rand können abgeschnitten werden. Ein Vollbild ohne Beschnitt benötigt einen eigenen Patch pro Spiel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellenar recorta la imagen 16:9 del juego para cubrir la pantalla. Las barras de salud, los subtítulos o los mapas cercanos a los bordes pueden quedar cortados. Mostrar una imagen a pantalla completa sin recortarla requiere un parche para cada juego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencher recorta a imagem 16:9 do jogo para cobrir a tela. Barras de vida, legendas ou mapas perto das bordas podem ser cortados. Uma imagem em tela cheia sem cortes exige um patch para cada jogo."
          }
        }
      }
    },
    "Fill crops the picture to cover the screen, Fit shows all of it, Stretch distorts it to fit.": {
      "comment": "SettingsCatalog.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill crops the picture to cover the screen, Fit shows all of it, Stretch distorts it to fit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempi ritaglia l’immagine per coprire lo schermo, Adatta la mostra interamente, Allunga la deforma per adattarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplir recadre l’image pour couvrir l’écran, Ajuster l’affiche entièrement, Étirer la déforme pour l’adapter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Füllen“ beschneidet das Bild bildschirmfüllend, „Einpassen“ zeigt es vollständig und „Strecken“ verzerrt es passend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellenar recorta la imagen para cubrir la pantalla, Ajustar la muestra entera y Estirar la deforma para encajar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencher recorta a imagem para cobrir a tela; Ajustar mostra a imagem inteira; Esticar distorce a imagem para caber."
          }
        }
      }
    },
    "Fill crops to cover, Fit shows all of it, Stretch distorts it to fit. Applies to wallpapers.": {
      "comment": "SettingsLookSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill crops to cover, Fit shows all of it, Stretch distorts it to fit. Applies to wallpapers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempi ritaglia per coprire l’area, Adatta mostra l’intera immagine, Allunga la deforma per adattarla. Si applica agli sfondi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplir recadre pour couvrir, Ajuster affiche toute l’image, Étirer la déforme pour l’adapter. S’applique aux fonds d’écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Füllen“ beschneidet das Bild flächendeckend, „Einpassen“ zeigt es vollständig und „Strecken“ verzerrt es passend. Gilt für Hintergrundbilder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellenar recorta para cubrir, Ajustar muestra toda la imagen y Estirar la deforma para encajar. Se aplica a los fondos de pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencher recorta a imagem para cobrir a área; Ajustar mostra a imagem inteira; Esticar distorce a imagem para caber. Aplica-se aos papéis de parede."
          }
        }
      }
    },
