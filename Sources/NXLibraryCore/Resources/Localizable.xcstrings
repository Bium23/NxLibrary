    "NX Library could not save your library, so recent changes may be lost when it quits: ": {
      "comment": "AppViewModel.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NX Library could not save your library, so recent changes may be lost when it quits: "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NX Library non ha potuto salvare la libreria; le modifiche recenti potrebbero andare perse alla chiusura: "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NX Library n’a pas pu enregistrer votre bibliothèque. Les modifications récentes risquent donc d’être perdues à sa fermeture : "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NX Library konnte deine Bibliothek nicht speichern. Daher können beim Beenden die letzten Änderungen verloren gehen: "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NX Library no ha podido guardar la biblioteca, por lo que los cambios recientes podrían perderse al salir: "
