    "Intermediate files created during shader translation and staging in the app-owned workspace. Deleting them frees disk space; your built games and saves will not be touched.": {
      "comment": "SettingsStorageSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intermediate files created during shader translation and staging in the app-owned workspace. Deleting them frees disk space; your built games and saves will not be touched."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File intermedi creati durante la traduzione degli shader e la preparazione nell’area di lavoro gestita dall’app. Eliminarli libera spazio su disco; i giochi compilati e i salvataggi non verranno modificati."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers intermédiaires créés lors de la traduction des shaders et de la préparation dans l’espace de travail de l’app. Les supprimer libère de l’espace disque ; vos jeux compilés et sauvegardes restent intacts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischendateien, die beim Übersetzen von Shadern und bei der Vorbereitung im app-eigenen Arbeitsverzeichnis entstehen. Löschen gibt Speicherplatz frei; erstellte Spiele-Apps und Spielstände bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos intermedios creados durante la traducción de shaders y la preparación en el espacio de trabajo de la app. Eliminarlos libera espacio en disco; los juegos compilados y las partidas guardadas seguirán intactos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos intermediários criados durante a tradução de shaders e a preparação na área de trabalho do app. Apagá-los libera espaço em disco; seus jogos compilados e dados salvos não serão alterados."
          }
        }
      }
    },
