    "Play time is tracked only for launches from NX Library. Not affiliated with Nintendo.": {
      "comment": "SettingsAboutSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play time is tracked only for launches from NX Library. Not affiliated with Nintendo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo di gioco viene registrato solo per gli avvii da NX Library. Non affiliata a Nintendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps de jeu est comptabilisé uniquement pour les lancements depuis NX Library. Sans affiliation avec Nintendo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielzeit wird nur bei Starts über NX Library erfasst. Keine Verbindung zu Nintendo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de juego solo se registra al iniciar desde NX Library. Sin afiliación con Nintendo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de jogo é registrado apenas quando o jogo é aberto pelo NX Library. Sem afiliação com a Nintendo."
          }
        }
      }
    },
    "Plays Joy-Con 2 and Pro Controller 2 over Bluetooth: hold Sync on one during the game to pair it. macOS asks once for Bluetooth access.": {
      "comment": "Engine game setting presentation; never translate env keys or values.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays Joy-Con 2 and Pro Controller 2 over Bluetooth: hold Sync on one during the game to pair it. macOS asks once for Bluetooth access."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente di giocare con Joy-Con 2 e Pro Controller 2 via Bluetooth: tieni premuto Sync su uno di essi durante il gioco per abbinarlo. macOS chiede una sola volta l’accesso al Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de jouer avec les Joy-Con 2 et la Pro Controller 2 en Bluetooth : maintenez Sync sur l’une de ces manettes pendant le jeu pour l’appairer. macOS demande une seule fois l’accès au Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützt Joy-Con 2 und Pro Controller 2 über Bluetooth: Halte während des Spiels die Sync-Taste am Controller gedrückt, um ihn zu koppeln. macOS fragt einmal nach Bluetooth-Zugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite jugar con Joy-Con 2 y Pro Controller 2 por Bluetooth: mantén pulsado Sync en uno durante el juego para enlazarlo. macOS pide acceso a Bluetooth una sola vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite jogar com Joy-Con 2 e Pro Controller 2 via Bluetooth: mantenha Sync pressionado em um deles durante o jogo para emparelhar. O macOS pede acesso ao Bluetooth uma vez."
          }
        }
      }
    },
