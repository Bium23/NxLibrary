            "value": "NX Library is personal software released under the MIT license. nxnative, Ryujinx, SPIR-V Cross, LibHac and the other dependencies retain their own licenses through the engine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NX Library è un software personale distribuito con licenza MIT. nxnative, Ryujinx, SPIR-V Cross, LibHac e le altre dipendenze mantengono le proprie licenze tramite il motore."
          }
        },
        "fr": {
          "stringUnit": {
