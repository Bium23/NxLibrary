    "The engine folder has changed files. NX Library never touches them: put them aside, then try again.": {
      "comment": "NewestEngine.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine folder has changed files. NX Library never touches them: put them aside, then try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella del motore contiene file modificati. NX Library non li tocca mai: mettili da parte, poi riprova."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier du moteur contient des fichiers modifiés. NX Library n’y touche jamais : mettez-les de côté, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Engine-Ordner enthält geänderte Dateien. NX Library verändert sie niemals: Lege sie beiseite und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta del motor contiene archivos modificados. NX Library nunca los modifica: apártalos e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta da engine tem arquivos alterados. O NX Library nunca os modifica: guarde-os em outro local e tente novamente."
          }
        }
      }
    },
    "The engine has no profile for this game, so it makes a provisional one. ": {
      "comment": "AddGameView+Rows.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine has no profile for this game, so it makes a provisional one. "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore non ha un profilo per questo gioco, quindi ne crea uno provvisorio. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur n’a pas de profil pour ce jeu ; il en crée donc un provisoire. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine hat kein Profil für dieses Spiel und erstellt daher ein vorläufiges. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor no tiene un perfil para este juego, así que crea uno provisional. "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A engine não tem um perfil para este jogo, então cria um provisório. "
          }
        }
      }
    },
    "The engine here is at %@, not the %@ this NX Library is tested with. Switch moves it to %@. Games you built keep playing.": {
      "comment": "SetupCheck.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine here is at %@, not the %@ this NX Library is tested with. Switch moves it to %@. Games you built keep playing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore qui è al commit %@, diverso da %@ con cui è testata questa NX Library. Con Cambia lo porti a %@. I giochi già compilati continuano a funzionare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur présent est au commit %@, et non au commit %@ avec lequel cette version de NX Library a été testée. Changer le fait passer au commit %@. Les jeux déjà compilés restent jouables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine hier steht auf %@ statt auf %@, womit diese NX Library-Version getestet wurde. „Wechseln“ setzt sie auf %@. Bereits erstellte Spiele bleiben spielbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor local está en %@, en lugar de %@, con el que se ha probado este NX Library. Cambiar lo mueve a %@. Los juegos ya compilados siguen funcionando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A engine aqui está em %@, e não em %@, com o qual este NX Library foi testado. Trocar a move para %@. Seus jogos compilados continuam funcionando."
          }
        }
      }
    },
