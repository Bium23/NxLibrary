    "A personal macOS front-end for building and launching your own Switch games with nxnative.": {
      "comment": "SettingsAboutSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A personal macOS front-end for building and launching your own Switch games with nxnative."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’interfaccia personale per macOS per creare e avviare i tuoi giochi Switch con nxnative."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
