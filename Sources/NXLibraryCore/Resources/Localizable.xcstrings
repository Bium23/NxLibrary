    "%@'s package is cut off or its own tables fail their hash check: an incomplete copy or a broken download.": {
      "comment": "PortingFailureReason.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s package is cut off or its own tables fail their hash check: an incomplete copy or a broken download."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pacchetto di %@ è troncato o le sue tabelle non superano la verifica dell’hash: una copia incompleta o un download danneggiato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet de %@ est tronqué ou ses tables internes échouent à la vérification d’empreinte : copie incomplète ou téléchargement endommagé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Paket von %@ ist abgeschnitten oder seine eigenen Tabellen bestehen die Hash-Prüfung nicht: eine unvollständige Kopie oder ein fehlerhafter Download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete de %@ está truncado o sus tablas internas no superan la comprobación de hash: una copia incompleta o una descarga dañada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote de %@ está truncado ou suas próprias tabelas falham na verificação de hash: uma cópia incompleta ou um download corrompido."
          }
        }
      }
    },
