    "Some folders are unavailable. Totals include readable files only. Connect their drives or check folder access, then recalculate.": {
      "comment": "SettingsStorageSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some folders are unavailable. Totals include readable files only. Connect their drives or check folder access, then recalculate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune cartelle non sono disponibili. I totali includono solo i file leggibili. Collega le relative unità o controlla l’accesso alle cartelle, poi ricalcola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains dossiers sont indisponibles. Les totaux incluent uniquement les fichiers lisibles. Connectez leurs disques ou vérifiez l’accès aux dossiers, puis recalculez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Ordner sind nicht verfügbar. Die Summen berücksichtigen nur lesbare Dateien. Verbinde ihre Laufwerke oder prüfe den Ordnerzugriff und berechne dann neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas carpetas no están disponibles. Los totales solo incluyen archivos legibles. Conecta sus unidades o comprueba el acceso a las carpetas y vuelve a calcular."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas pastas estão indisponíveis. Os totais incluem apenas arquivos legíveis. Conecte as unidades ou verifique o acesso às pastas e recalcule."
          }
        }
      }
    },
    "Some game files are damaged": {
