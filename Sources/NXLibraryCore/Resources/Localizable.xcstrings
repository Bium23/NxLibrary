    "The porting started an Intel Python, so its tools ran under Rosetta.": {
      "comment": "PortingFailureReason.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The porting started an Intel Python, so its tools ran under Rosetta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La creazione dell’app per Mac ha avviato un Python Intel, quindi i relativi strumenti sono stati eseguiti tramite Rosetta."
          }
        },
        "fr": {
          "stringUnit": {
