    "Adjusts minimum thumbstick deflection needed to trigger menu navigation. Increase if your analog stick has slight drift causing unintended scrolling.": {
      "comment": "SettingsControllersSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusts minimum thumbstick deflection needed to trigger menu navigation. Increase if your analog stick has slight drift causing unintended scrolling."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola lo spostamento minimo dello stick necessario per navigare nei menu. Aumentalo se una lieve deriva dello stick causa scorrimenti involontari."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle l’inclinaison minimale du stick nécessaire pour naviguer dans les menus. Augmentez-la si une légère dérive du stick analogique provoque un défilement involontaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, wie weit du den Stick mindestens bewegen musst, um durch Menüs zu navigieren. Erhöhe den Wert, wenn leichter Stick-Drift unbeabsichtigtes Scrollen verursacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta cuánto debes mover el stick para navegar por los menús. Auméntalo si el stick tiene una ligera deriva que provoca desplazamientos involuntarios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta o movimento mínimo do analógico necessário para navegar pelos menus. Aumente se o analógico apresentar um leve desvio que cause rolagem involuntária."
          }
        }
      }
    },
