    "The folder is unavailable. Connect its drive and check folder access, then recalculate storage.": {
      "comment": "StorageManager.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder is unavailable. Connect its drive and check folder access, then recalculate storage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella non è disponibile. Collega la relativa unità e controlla l’accesso alla cartella, poi ricalcola lo spazio occupato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier est indisponible. Connectez son disque et vérifiez l’accès au dossier, puis recalculez le stockage."
          }
        },
