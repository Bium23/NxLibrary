    "The original file is untouched. The stored copy is mode 0600 and key values are never shown or logged.": {
      "comment": "SettingsEngineSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file is untouched. The stored copy is mode 0600 and key values are never shown or logged."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file originale non viene modificato. La copia memorizzata ha permessi 0600 e i valori delle chiavi non vengono mai mostrati né registrati nei log."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier d’origine reste intact. La copie enregistrée utilise les permissions 0600 et les valeurs des clés ne sont jamais affichées ni inscrites dans les journaux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originaldatei bleibt unverändert. Die gespeicherte Kopie hat Zugriffsrechte 0600; Schlüsselwerte werden nie angezeigt oder protokolliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo original sigue intacto. La copia guardada tiene permisos 0600 y los valores de las claves nunca se muestran ni se escriben en los registros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo original não é alterado. A cópia armazenada tem permissões 0600, e os valores das chaves nunca são exibidos nem registrados em logs."
          }
        }
      }
    },
