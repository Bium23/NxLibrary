    "When you close a game, a card shows how long you played this time and in total.": {
      "comment": "SettingsCatalog.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you close a game, a card shows how long you played this time and in total."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando chiudi un gioco, una scheda mostra quanto hai giocato nella sessione e in totale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous fermez un jeu, une fiche indique le temps joué pendant cette session et au total."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Spiel beendest, zeigt eine Karte deine Spielzeit dieser Sitzung und insgesamt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cierras un juego, una tarjeta muestra cuánto has jugado en esta sesión y en total."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao encerrar um jogo, um cartão mostra por quanto tempo você jogou nesta sessão e no total."
          }
        }
      }
    },
    "When you close a game, a card shows how long you played this time and in total. Sessions under 10 seconds show none.": {
      "comment": "SettingsGamesSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you close a game, a card shows how long you played this time and in total. Sessions under 10 seconds show none."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando chiudi un gioco, una scheda mostra quanto hai giocato nella sessione e in totale. Non appare per le sessioni inferiori a 10 secondi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous fermez un jeu, une fiche indique le temps joué pendant cette session et au total. Aucune fiche ne s’affiche pour les sessions de moins de 10 secondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Spiel beendest, zeigt eine Karte deine Spielzeit dieser Sitzung und insgesamt. Bei Sitzungen unter 10 Sekunden erscheint keine Karte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cierras un juego, una tarjeta muestra cuánto has jugado en esta sesión y en total. No se muestra para sesiones de menos de 10 segundos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao encerrar um jogo, um cartão mostra por quanto tempo você jogou nesta sessão e no total. Sessões com menos de 10 segundos não exibem cartão."
          }
        }
      }
    },
