    "Changes apply at the next launch. If a mod changes nothing, rebuild the game.": {
      "comment": "ModsPanel.swift:400",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply at the next launch. If a mod changes nothing, rebuild the game."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche si applicano al prossimo avvio. Se una mod non produce cambiamenti, ricompila il gioco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s’appliquent au prochain lancement. Si un mod n’a aucun effet, recompilez le jeu."
