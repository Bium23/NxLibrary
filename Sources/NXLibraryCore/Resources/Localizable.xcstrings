          "stringUnit": {
            "state": "translated",
            "value": "Preparazione dell’icona dell’app. Il gioco si avvierà quando sarà pronta. Per un gioco di grandi dimensioni può servire un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparation de l’icône de l’app. Le jeu démarrera dès qu’elle sera prête. Cela peut prendre une minute pour un jeu volumineux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das App-Symbol wird vorbereitet. Sobald es fertig ist, startet das Spiel. Bei großen Spielen kann das eine Minute dauern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando el icono de la app. El juego se iniciará cuando esté listo. Si el juego es grande, puede tardar un minuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando o ícone do app. O jogo será iniciado assim que estiver pronto. Isso pode levar um minuto para jogos grandes."
          }
        }
      }
    },
