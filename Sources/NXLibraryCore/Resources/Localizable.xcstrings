    "The engine could not be switched: %@": {
      "comment": "NewestEngine.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine could not be switched: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
