      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which cards sit in the Spotlight row: Collection, Surprise me, Activity, Mods and Add game."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
