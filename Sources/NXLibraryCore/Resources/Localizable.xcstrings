          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un gioco base. Non è possibile creare un’app solo con aggiornamenti e DLC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un jeu de base. Les mises à jour et les DLC seuls ne peuvent pas être compilés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Basisspiel. Updates und DLC allein lassen sich nicht als App erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
