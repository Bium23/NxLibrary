    "Checks Game apps and its subfolders. Existing library entries are kept; no apps are moved. Source files are optional for Play.": {
      "comment": "SettingsLibrarySection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks Game apps and its subfolders. Existing library entries are kept; no apps are moved. Source files are optional for Play."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla App dei giochi e le sue sottocartelle. Le voci esistenti della libreria vengono conservate; nessuna app viene spostata. I file sorgente non sono necessari per giocare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie Apps de jeux et ses sous-dossiers. Les entrées existantes de la bibliothèque sont conservées ; aucune app n’est déplacée. Les fichiers sources sont facultatifs pour Jouer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft den Spiele-App-Ordner und seine Unterordner. Vorhandene Bibliothekseinträge bleiben erhalten; Apps werden nicht verschoben. Quelldateien sind zum Spielen optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la carpeta Apps de juegos y sus subcarpetas. Conserva las entradas existentes de la biblioteca; no se mueve ninguna app. Los archivos de origen son opcionales para jugar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica Apps de jogos e suas subpastas. As entradas existentes da biblioteca são mantidas; nenhum app é movido. Os arquivos de origem são opcionais para Jogar."
          }
        }
      }
    },
    "Checks the engine and toolchain each time NX Library starts.": {
      "comment": "SettingsCatalog.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks the engine and toolchain each time NX Library starts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il motore e la toolchain a ogni avvio di NX Library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie le moteur et la chaîne d’outils à chaque démarrage de NX Library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft Engine und Toolchain bei jedem Start von NX Library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el motor y la cadena de herramientas cada vez que se inicia NX Library."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica a engine e o conjunto de ferramentas sempre que o NX Library inicia."
          }
        }
      }
    },
    "Checks the nxnative checkout against the certified engine commit and confirms your installed Metal compiler matches the lock file before builds are attempted.": {
      "comment": "SettingsStartUpSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks the nxnative checkout against the certified engine commit and confirms your installed Metal compiler matches the lock file before builds are attempted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il checkout di nxnative rispetto al commit certificato del motore e verifica che il compilatore Metal installato corrisponda al file di vincoli prima di tentare una compilazione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie la copie de travail de nxnative par rapport au commit certifié du moteur et confirme que le compilateur Metal installé correspond au fichier de verrouillage avant toute tentative de compilation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft den nxnative-Checkout anhand des zertifizierten Engine-Commits und bestätigt vor Build-Versuchen, dass der installierte Metal-Compiler der Lockdatei entspricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la copia local de nxnative con el commit certificado del motor y confirma que el compilador Metal instalado coincide con el archivo de certificación antes de intentar compilar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica o checkout do nxnative em relação ao commit certificado da engine e confirma se o compilador Metal instalado corresponde ao arquivo de versões fixadas antes de tentar compilar."
          }
        }
      }
    },
