          }
        }
      }
    },
    "A report for an issue: versions, setup and the last porting. No keys.": {
      "comment": "SettingsAboutSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A report for an issue: versions, setup and the last porting. No keys."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rapporto per segnalare un problema: versioni, configurazione e ultima creazione dell’app per Mac. Nessuna chiave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rapport pour signaler un problème : versions, configuration et dernière création d’app Mac. Aucune clé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bericht zur Fehlerbehebung: Versionen, Einrichtung und letzte App-Erstellung. Keine Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un informe para comunicar un problema: versiones, configuración y última compilación. Sin claves."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um relatório para relatar um problema: versões, configuração e a última compilação. Sem chaves."
          }
        }
      }
    },
    "A save from a newer game version may not load. Cloud saves may replace this local save if you turn sync on later.": {
      "comment": "Save safety and presentation; user content stays unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A save from a newer game version may not load. Cloud saves may replace this local save if you turn sync on later."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salvataggio creato con una versione più recente del gioco potrebbe non caricarsi. Se attivi la sincronizzazione in seguito, i salvataggi cloud potrebbero sostituire quello locale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde créée avec une version plus récente du jeu peut ne pas se charger. Les sauvegardes cloud peuvent remplacer ces données locales si vous activez la synchronisation plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Spielstand aus einer neueren Spielversion lässt sich möglicherweise nicht laden. Wenn du die Synchronisierung später aktivierst, können Cloud-Spielstände diesen lokalen Spielstand ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una partida de una versión más reciente del juego podría no cargarse. Si activas la sincronización más adelante, las partidas de la nube podrían reemplazar esta partida local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um salvamento de uma versão mais recente do jogo pode não carregar. Se você ativar a sincronização depois, os salvamentos na nuvem poderão substituir este salvamento local."
          }
        }
      }
    },
    "A save operation or app installation is in progress for this game.": {
      "comment": "SaveLocation.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A save operation or app installation is in progress for this game."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in corso un’operazione sui salvataggi o un’installazione dell’app per questo gioco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une opération de sauvegarde ou une installation d’app est en cours pour ce jeu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Spiel läuft gerade ein Spielstandvorgang oder eine App-Installation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una operación de partidas guardadas o una instalación de la app en curso para este juego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma operação de dados salvos ou uma instalação do app em andamento para este jogo."
          }
        }
      }
    },
