    "Simulates the Nintendo Switch docked TV profile (1080p target, higher clocks and memory limits). Disabling uses handheld profile (720p target, lower GPU load).": {
      "comment": "SettingsGamesSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulates the Nintendo Switch docked TV profile (1080p target, higher clocks and memory limits). Disabling uses handheld profile (720p target, lower GPU load)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula il profilo TV di Nintendo Switch nel dock (obiettivo 1080p, frequenze e limiti di memoria più alti). Se disattivata, usa il profilo portatile (obiettivo 720p, carico GPU inferiore)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simule le profil téléviseur de la Nintendo Switch sur sa station d’accueil (cible 1080p, fréquences et limites de mémoire plus élevées). Le désactiver utilise le profil portable (cible 720p, charge GPU réduite)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simuliert das TV-Profil der Nintendo Switch im Dock (Zielauflösung 1080p, höhere Taktraten und Speichergrenzen). Deaktiviert wird das Handheld-Profil verwendet (Zielauflösung 720p, geringere GPU-Last)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula el perfil de Nintendo Switch conectada al televisor (objetivo de 1080p, frecuencias y límites de memoria más altos). Al desactivarlo, se usa el perfil portátil (objetivo de 720p, menor carga de GPU)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula o perfil do Nintendo Switch conectado à TV (resolução alvo de 1080p, frequências mais altas e limites maiores de memória). Ao desativar, usa o perfil portátil (resolução alvo de 720p, menor carga na GPU)."
          }
        }
      }
    },
